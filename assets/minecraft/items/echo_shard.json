{
  "model": {
    "type": "minecraft:range_dispatch",
    "property": "minecraft:custom_model_data",
    "entries": [
      {
        "threshold": 1,
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/key"
        }
      },
      {
        "threshold": 2,
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/animated_key"
        }
      },
      {
        "threshold": 3,
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/key_cooldown"
        }
      },
      {
        "threshold": 4,
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/key_disabled"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
    "model": "minecraft:item/echo_shard",
    "property": "minecraft:component",
    "component": "minecraft:custom_data",
    "cases": [
      {
        "when": {
          "ff_key_anim": true
        },
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/animated_key"
        }
      },
      {
        "when": {
          "ff_key": true,
          "itemID": "key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/key"
        }
      },
      {
        "when": {
          "itemID": "animated_key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/animated_key"
        }
      },
      {
        "when": {
          "itemID": "key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/key"
        }
      },
      {
        "when": {
          "ff_key_cooldown": true
        },
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/key_cooldown"
        }
      },
      {
        "when": {
          "itemID": "key_cooldown"
        },
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/key_cooldown"
        }
      },
      {
        "when": {
          "ff_key_disabled": true
        },
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/key_disabled"
        }
      },
      {
        "when": {
          "itemID": "key_disabled"
        },
        "model": {
          "type": "minecraft:model",
          "model": "fossil-frights:item/general_items/key_disabled"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "model": "minecraft:item/echo_shard",
      "property": "minecraft:component",
      "component": "minecraft:lore",
      "cases": [
        {
          "when": [
            {
              "extra": [
                "animated_key"
              ],
              "text": ""
            }
          ],
          "model": {
            "type": "minecraft:model",
            "model": "fossil-frights:item/general_items/animated_key"
          }
        },
        {
          "when": [
            {
              "extra": [
                "key"
              ],
              "text": ""
            }
          ],
          "model": {
            "type": "minecraft:model",
            "model": "fossil-frights:item/general_items/key"
          }
        },
        {
          "when": [
            {
              "extra": [
                "key_cooldown"
              ],
              "text": ""
            }
          ],
          "model": {
            "type": "minecraft:model",
            "model": "fossil-frights:item/general_items/key_cooldown"
          }
        },
        {
          "when": [
            {
              "extra": [
                "key_disabled"
              ],
              "text": ""
            }
          ],
          "model": {
            "type": "minecraft:model",
            "model": "fossil-frights:item/general_items/key_disabled"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/echo_shard"
      }
    }
    }
  }
}
